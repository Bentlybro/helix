/* XIAO nRF52840 Sense Pin Definitions for Helix-Mic */

/ {
    /* Add alias for DMIC device for broader compatibility */
    aliases {
        dmic-dev = &pdm0;
    };
};

/* Add pinctrl entries for PDM microphone */
&pinctrl {
    pdm0_default: pdm0_default {
        group1 {
            psels = <NRF_PSEL(PDM_CLK, 0, 16)>,  /* CLK on P0.16 */
                    <NRF_PSEL(PDM_DIN, 0, 17)>;  /* DIN on P0.17 */
        };
    };

    pdm0_sleep: pdm0_sleep {
        group1 {
            psels = <NRF_PSEL(PDM_CLK, 0, 16)>,
                    <NRF_PSEL(PDM_DIN, 0, 17)>;
            low-power-enable;
        };
    };
};

/* Enable PDM microphone */
&pdm0 {
    status = "okay";
    pinctrl-0 = <&pdm0_default>;
    pinctrl-1 = <&pdm0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-source = "PCLK32M";
    queue-size = <4>;
};
