/* XIAO nRF52840 Sense overlay for Helix-Mic — Zephyr DMIC API */
/* PDM pins per Seeed variant.cpp: CLK=P1.0, DATA=P0.16, PWR=P1.10 */

#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	msm261d3526hicpm_c_en: msm261d3526hicpm-c-en {
		compatible = "regulator-fixed";
		enable-gpios = <&gpio1 10 GPIO_ACTIVE_HIGH>;
		regulator-name = "MSM261D3526HICPM-C-EN";
		regulator-boot-on;
	};
};

&pinctrl {
	pdm0_default_alt: pdm0_default_alt {
		group1 {
			psels = <NRF_PSEL(PDM_CLK, 1, 0)>,   /* P1.0 = D20 = PDM_CLK */
				<NRF_PSEL(PDM_DIN, 0, 16)>;  /* P0.16 = D21 = PDM_DATA */
		};
	};
};

dmic_dev: &pdm0 {
	status = "okay";
	pinctrl-0 = <&pdm0_default_alt>;
	pinctrl-names = "default";
	clock-source = "PCLK32M_HFXO";
};
