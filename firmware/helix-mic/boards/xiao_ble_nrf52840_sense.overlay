/* XIAO nRF52840 Sense overlay for Helix-Mic — NCS v3.2.4 / Zephyr 4.x */
/* Board DTS already sets correct PDM pins (CLK=P1.0, DIN=P0.16) and pinctrl. */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>

/ {
	msm261d3526hicpm_c_en: msm261d3526hicpm-c-en {
		compatible = "regulator-fixed";
		enable-gpios = <&gpio1 10 GPIO_ACTIVE_HIGH>;
		regulator-name = "MSM261D3526HICPM-C-EN";
		regulator-boot-on;
	};
};

dmic_dev: &pdm0 {
	status = "okay";
	clock-source = "PCLK32M_HFXO";
};

&adc {
	status = "okay";
	/delete-property/ zephyr,pm-device-runtime-auto;
};
